# Servidor local OpenAI-compatible. A base deve incluir /v1.
OPENAI_PROVIDER=local
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_MODEL=

# Opcional para servidores locais sem autenticacao.
OPENAI_API_KEY=

# Use somente se o servidor expuser uma rota fora do padrao.
# OPENAI_CHAT_COMPLETIONS_URL=http://127.0.0.1:8080/v1/chat/completions
OPENAI_TIMEOUT_SECONDS=120

TESSERACT_LANG=por+eng
MAX_PAGES_PER_PDF=12
MAX_IMAGES_PER_PDF=4
MAX_INPUT_CHARS=24000

